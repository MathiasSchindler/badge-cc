if(PROJECT_NAME STREQUAL "firmware" AND CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
    function(badge_replace_source source object)
        if(NOT EXISTS "${object}")
            message(FATAL_ERROR "Missing owned object: ${object}")
        endif()
        get_target_property(sources firmware SOURCES)
        set(stock "${CMAKE_CURRENT_SOURCE_DIR}/../../${source}")
        cmake_path(NORMAL_PATH stock)
        list(FIND sources "${stock}" index)
        if(index EQUAL -1)
            message(FATAL_ERROR "Could not locate the stock translation unit: ${source}")
        endif()
        list(REMOVE_AT sources ${index})
        set_property(TARGET firmware PROPERTY SOURCES "${sources}")
        set_source_files_properties("${object}" PROPERTIES EXTERNAL_OBJECT TRUE)
        target_sources(firmware PRIVATE "${object}")
    endfunction()
    function(badge_replace_modules)
        badge_replace_source("lib/littlefs/lfs2_util.c" "${BADGE_LFS2_OBJECT}")
        if(BADGE_SMALLINT_OBJECT)
            badge_replace_source("py/smallint.c" "${BADGE_SMALLINT_OBJECT}")
        endif()
        if(BADGE_RADIX_OBJECT)
            badge_replace_source("py/parsenumbase.c" "${BADGE_RADIX_OBJECT}")
        endif()
        if(BADGE_UNICODE_OBJECT)
            badge_replace_source("py/unicode.c" "${BADGE_UNICODE_OBJECT}")
        endif()
        if(BADGE_TIMEUTILS_OBJECT)
            badge_replace_source("shared/timeutils/timeutils.c" "${BADGE_TIMEUTILS_OBJECT}")
        endif()
        if(BADGE_SEQUENCE_OBJECT)
            badge_replace_source("py/sequence.c" "${BADGE_SEQUENCE_OBJECT}")
        endif()
        if(BADGE_RUNTIME_OBJECT)
            badge_replace_source("py/runtime.c" "${BADGE_RUNTIME_OBJECT}")
        endif()
        if(BADGE_VM_OBJECT)
            badge_replace_source("py/vm.c" "${BADGE_VM_OBJECT}")
        endif()
    endfunction()
    cmake_language(DEFER CALL badge_replace_modules)
endif()
