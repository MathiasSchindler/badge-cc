if(PROJECT_NAME STREQUAL "firmware" AND CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
    function(badge_replace_littlefs_crc)
        if(NOT EXISTS "${BADGE_LFS2_OBJECT}")
            message(FATAL_ERROR "Missing owned LittleFS object: ${BADGE_LFS2_OBJECT}")
        endif()
        get_target_property(sources firmware SOURCES)
        set(stock "${CMAKE_CURRENT_SOURCE_DIR}/../../lib/littlefs/lfs2_util.c")
        cmake_path(NORMAL_PATH stock)
        list(FIND sources "${stock}" index)
        if(index EQUAL -1)
            message(FATAL_ERROR "Could not locate the stock LittleFS CRC translation unit")
        endif()
        list(REMOVE_AT sources ${index})
        set_property(TARGET firmware PROPERTY SOURCES "${sources}")
        set_source_files_properties("${BADGE_LFS2_OBJECT}" PROPERTIES EXTERNAL_OBJECT TRUE)
        target_sources(firmware PRIVATE "${BADGE_LFS2_OBJECT}")
    endfunction()
    cmake_language(DEFER CALL badge_replace_littlefs_crc)
endif()
